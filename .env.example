# Copy to an untracked .env and fill locally. NEVER commit a real credential.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
FACILITY_RISK_AUTH_TOKEN=
FACILITY_RISK_BASIC_USER=analyst

# Optional distinct user auth for PRIVATE research/second-party approval.
# The JSON must be supplied through your secret manager, not this tracked file.
# FACILITY_RISK_USERS_JSON must map user IDs to {"role":"reviewer|approver|...","password_hash":"pbkdf2_sha256$..."}.
# Generate a verifier interactively using security.make_password_hash(getpass.getpass()).
FACILITY_RISK_USERS_JSON=
FACILITY_RISK_DUAL_REVIEW=0
FACILITY_RISK_ENABLE_WRITES=0

# Optional source-only search sidecars, mounted readonly on a private server.
# Leave empty unless the matching QA/manifests and SQLite were independently installed.
# For Docker Compose, use paths INSIDE the container under /app/source-index.
# FACILITY_RISK_FRS_INDEX_PATH=/app/source-index/full-frs-index.sqlite
# FACILITY_RISK_FRS_INDEX_QA=/app/source-index/full-frs-index-qa.json
# FACILITY_RISK_NOAA_INDEX_PATH=/app/source-index/noaa-storm-only.sqlite
# FACILITY_RISK_NOAA_INDEX_MANIFEST=/app/source-index/noaa-storm-events-manifest.json

# Optional NOAA OR&R IncidentNews selected-response source (not complete NRC release census).
# FACILITY_RISK_INCIDENTNEWS_INDEX_PATH=/app/source-index/incidentnews-source-only.sqlite
# FACILITY_RISK_INCIDENTNEWS_INDEX_MANIFEST=/app/source-index/incidentnews-manifest.json

# Private industrial reporting source-only indexes: set these INSIDE container
# after separately installing SHA-verified releases into ./source-index/...
# Not GitHub Pages; unset means no mounted source coverage.
FACILITY_RISK_LANE_C_ROOT=
FACILITY_RISK_PHMSA_WMS_ROOT=

# REQUIRED for REAL Lane C installations: private host mount OUTSIDE the Git
# checkout, encrypted/backed up. The Compose container reads this at
# /app/source-index using UID 10001; install/chown permissions accordingly.
FACILITY_RISK_PRIVATE_SOURCE_HOST_DIR=
# Set private container paths only after successful SHA-verified installation:
# FACILITY_RISK_LANE_C_ROOT=/app/source-index/lane-c
# FACILITY_RISK_PHMSA_WMS_ROOT=/app/source-index/phmsa-wms

# Optional merged Lane A flood/wildfire source-only read-only release.
# Install and verify the original government source artifact first.
# In Compose, /app/source-index/lane-a must contain current.json + releases/<sha>.
# FACILITY_RISK_LANE_A_INDEX_ROOT=/app/source-index/lane-a

# EPA ECHO, RCRAInfo, 38 annual TRI Basic partitions, and public FRS-RMP interest.
# Install immutable, SHA256-verified source indexes first (see docs/EPA_LANE_B_DEPLOYMENT.md).
# NEVER enable before private auth/TLS/tenant review; no source files are committed to Git.
FACILITY_RISK_LANE_B_ROUTES_ENABLED=0
# FACILITY_RISK_LANE_B_ECHO_DIRECTORY=/app/source-index/epa-echo-20261023
# FACILITY_RISK_LANE_B_RCRA_DIRECTORY=/app/source-index/epa-rcra-20261023
# FACILITY_RISK_LANE_B_TRI_ROOT=/app/source-index/epa-tri
# FACILITY_RISK_LANE_B_TRI_YEARS=1987-2024
# FACILITY_RISK_LANE_B_RMP_DIRECTORY=/app/source-index/epa-rmp-public-20261023

# Optional complete original USDA WHP2023 270m six-GeoTIFF private source-index release.
# Download+verify using scripts/lane_a_whp_full_raster.py first; source is ~368MB ZIP.
# This is a 2023 long-term landscape model, not an insured property loss score.
# FACILITY_RISK_WHP2023_RASTER_ROOT=/app/source-index/whp2023-full

# Lane D private source indexes (NO automatic utility/customer or loss matches).
# FACILITY_RISK_LANE_D_INDEX_ROOT=/app/source-index/lane-d
# FACILITY_RISK_LANE_D_ODIN_USE_APPROVED=0
# Private persistent source-index root is configured through FACILITY_RISK_PRIVATE_SOURCE_HOST_DIR in Compose.
